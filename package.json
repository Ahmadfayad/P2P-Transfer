{
  "name": "uos-document-exchange",
  "version": "3.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "build:qr": "esbuild node_modules/qrcode/lib/browser.js --bundle --format=esm --minify --outfile=public/vendor/qrcode.js",
    "deploy": "wrangler deploy",
    "check": "node --check server/worker.js && node --check public/app.js && node --check public/transfer.js",
    "test": "node --test tests/*.test.js",
    "test:browser": "node tests/browser.mjs"
  },
  "devDependencies": {
    "playwright": "1.64.0",
    "qrcode": "1.5.4",
    "wrangler": "4.149.0"
  }
}
